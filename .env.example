# ==============================================================================
# SentinelOS Backend Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure as needed.
# Note: AI models are NOT installed or configured by default.
# The SentinelOS core, API, and tool orchestrator run independently of model availability.
# ==============================================================================

# Workspace Root Directory
# Defaults to ./workspace within the SentinelOS root
SENTINEL_WORKSPACE_ROOT="./workspace"

# Local AI Model Runtime (e.g., Ollama)
# Connects to your local model server when installed and started.
OLLAMA_HOST="http://127.0.0.1:11434"

# Model Routing Backend Policy: local | omniroute | auto
# - local: Use local Ollama provider directly (default)
# - omniroute: Route model queries through OmniRoute federated proxy
# - auto: Route through OmniRoute with fallback to local Ollama if configured
SENTINEL_AI_BACKEND="local"

# OmniRoute Federated Proxy Settings (Optional)
SENTINEL_OMNIROUTE_ENABLED="false"
SENTINEL_OMNIROUTE_BASE_URL="http://127.0.0.1:20128/v1"
# SENTINEL_OMNIROUTE_API_KEY="your-api-key-here"
SENTINEL_OMNIROUTE_FALLBACK_TO_LOCAL="true"
SENTINEL_OMNIROUTE_DATA_POLICY="redact"

# Remote Task-to-Model Mapping (JSON format)
SENTINEL_OMNIROUTE_MODELS="{}"
